<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>
	<parent>
		<groupId>fr.guiguilechat.jcelechat.libs</groupId>
		<artifactId>esi</artifactId>
		<version>8.0.2</version>
	</parent>
	<groupId>fr.guiguilechat.jcelechat.libs.esi</groupId>
	<artifactId>generated</artifactId>
	<name>LIB ESI generated</name>

	<dependencies>
		<dependency>
			<groupId>fr.guiguilechat.jcelechat.libs.esi</groupId>
			<artifactId>commons</artifactId>
		</dependency>
		<dependency>
			<groupId>org.projectlombok</groupId>
			<artifactId>lombok</artifactId>
			<optional>true</optional>
		</dependency>
	</dependencies>
	<build>
		<plugins>
			<plugin>
				<groupId>org.codehaus.mojo</groupId>
				<artifactId>build-helper-maven-plugin</artifactId>
				<executions>
					<execution>
						<id>generate source</id>
						<phase>generate-sources</phase>
						<goals>
							<goal>add-source</goal>
						</goals>
						<configuration>
							<sources>
								<source>src/generated/java</source>
							</sources>
						</configuration>
					</execution>
				</executions>
			</plugin>
		</plugins>
	</build>
	<profiles>
		<profile>
			<id>buildccp</id>
			<build>
				<plugins>
					<plugin>
						<artifactId>maven-clean-plugin</artifactId>
						<configuration>
							<filesets>
								<fileset>
									<directory>src/generated/java</directory>
								</fileset>
							</filesets>
						</configuration>
					</plugin>
					<plugin>
						<groupId>com.helger.jcodemodel</groupId>
						<artifactId>jcodemodel-maven-plugin</artifactId>
						<executions>
							<execution>
								<id>generate source</id>
								<goals>
									<goal>generate-source</goal>
								</goals>
								<configuration>
									<source>https://esi.evetech.net/meta/openapi.json?compatibility_date=2026-08-18</source>
								</configuration>
							</execution>
						</executions>
						<dependencies>
							<dependency>
								<groupId>fr.guiguilechat.jcelechat.libs.esi</groupId>
								<artifactId>generator</artifactId>
								<version>${project.version}</version>
							</dependency>
						</dependencies>
					</plugin>
				</plugins>
			</build>
		</profile>
	</profiles>
</project>